{
  "$source": {
    "mui": "9.4.0",
    "x": "9.14.0",
    "tiers": {
      "@mui/x-date-pickers-pro": "9.14.0"
    }
  },
  "components": [
    "MuiClock",
    "MuiClockNumber",
    "MuiClockPointer",
    "MuiDateCalendar",
    "MuiDatePickerToolbar",
    "MuiDateRangeCalendar",
    "MuiDateRangePickerDay",
    "MuiDateRangePickerToolbar",
    "MuiDateTimePickerTabs",
    "MuiDateTimePickerToolbar",
    "MuiDateTimeRangePickerTabs",
    "MuiDateTimeRangePickerToolbar",
    "MuiDayCalendar",
    "MuiDayCalendarSkeleton",
    "MuiDigitalClock",
    "MuiMonthCalendar",
    "MuiMultiInputDateRangeField",
    "MuiMultiInputDateTimeRangeField",
    "MuiMultiInputTimeRangeField",
    "MuiMultiSectionDigitalClock",
    "MuiMultiSectionDigitalClockSection",
    "MuiPickerDay",
    "MuiPickerPopper",
    "MuiPickersArrowSwitcher",
    "MuiPickersCalendarHeader",
    "MuiPickersFadeTransitionGroup",
    "MuiPickersFilledInput",
    "MuiPickersInput",
    "MuiPickersInputBase",
    "MuiPickersLayout",
    "MuiPickersOutlinedInput",
    "MuiPickersSectionList",
    "MuiPickersSlideTransition",
    "MuiPickersTextField",
    "MuiPickersToolbar",
    "MuiPickersToolbarButton",
    "MuiPickersToolbarText",
    "MuiTimeClock",
    "MuiTimePickerToolbar",
    "MuiTimeRangePickerTabs",
    "MuiTimeRangePickerToolbar",
    "MuiYearCalendar"
  ],
  "graph": {
    "MuiDateCalendar": {
      "composes": [
        "MuiMonthCalendar",
        "MuiPickerDay",
        "MuiPickersCalendarHeader",
        "MuiYearCalendar"
      ]
    },
    "MuiDateRangePickerDay": {
      "contentSource": "typography.caption"
    },
    "MuiDateTimePickerToolbar": {
      "extends": "MuiPickersToolbar"
    },
    "MuiMonthCalendar": {
      "contentSource": "typography.subtitle1"
    },
    "MuiPickerDay": {
      "contentSource": "typography.caption"
    },
    "MuiPickersCalendarHeader": {
      "contentSource": "typography.body1"
    },
    "MuiPickersFilledInput": {
      "extends": "MuiPickersInputBase",
      "contentSource": "typography.body1",
      "contentSourceVia": "MuiPickersInputBase"
    },
    "MuiPickersInput": {
      "extends": "MuiPickersInputBase",
      "contentSource": "typography.body1",
      "contentSourceVia": "MuiPickersInputBase"
    },
    "MuiPickersInputBase": {
      "contentSource": "typography.body1"
    },
    "MuiPickersOutlinedInput": {
      "extends": "MuiPickersInputBase",
      "contentSource": "typography.body1",
      "contentSourceVia": "MuiPickersInputBase"
    },
    "MuiTimeRangePickerToolbar": {
      "extends": "MuiPickersToolbar"
    },
    "MuiYearCalendar": {
      "contentSource": "typography.subtitle1"
    },
    "MuiClockNumber": {
      "routes": {
        "disabled": [
          "&.Mui-disabled"
        ],
        "selected": [
          "&.Mui-selected"
        ]
      }
    },
    "MuiPickersSlideTransition": {
      "routes": {
        "slideEnter-left": [
          ".MuiPickersSlideTransition-slideEnter-left"
        ],
        "slideEnter-right": [
          ".MuiPickersSlideTransition-slideEnter-right"
        ],
        "slideEnterActive": [
          ".MuiPickersSlideTransition-slideEnterActive"
        ],
        "slideExit": [
          ".MuiPickersSlideTransition-slideExit"
        ],
        "slideExitActiveLeft-left": [
          ".MuiPickersSlideTransition-slideExitActiveLeft-left"
        ],
        "slideExitActiveLeft-right": [
          ".MuiPickersSlideTransition-slideExitActiveLeft-right"
        ]
      }
    }
  }
}
